{
  "name": "@elfui/kit",
  "version": "0.0.2-beta.2",
  "private": false,
  "type": "module",
  "description": "Official ElfUI component library built with macro components.",
  "main": "./lib-dist/elfui-kit.js",
  "module": "./lib-dist/elfui-kit.js",
  "types": "./lib-dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./lib-dist/library.d.ts",
      "import": "./lib-dist/elfui-kit.js"
    },
    "./labs": {
      "types": "./lib-dist/labs.d.ts",
      "import": "./lib-dist/labs.js"
    },
    "./styles/utilities.css": "./lib-dist/utilities.css"
  },
  "files": [
    "lib-dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./lib-dist/elfui-kit.js",
    "./lib-dist/labs.js",
    "./lib-dist/utilities.css"
  ],
  "scripts": {
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.lib.json && node ../../scripts/prepare-package.mjs packages/kit",
    "typecheck": "node ../../scripts/check-unsupported-macros.mjs src && node ../../scripts/typecheck-macros.mjs tsconfig.lib.json",
    "prepublishOnly": "pnpm --dir ../.. test:kit && pnpm build"
  },
  "dependencies": {
    "@elfui/core": "0.1.0-beta.21",
    "@elfui/router": "0.1.0-beta.11",
    "@mdi/js": "^7.4.47",
    "dompurify": "^3.2.4",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "prettier": "^3.9.6",
    "shiki": "^4.4.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@elfui/compiler": "0.1.0-beta.21",
    "@elfui/vite-plugin": "0.1.0-beta.21",
    "sass-embedded": "^1.83.0",
    "typescript": "~5.6.3",
    "vite": "^7.1.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloom-lmh/elfui-kit.git",
    "directory": "packages/kit"
  },
  "homepage": "https://github.com/bloom-lmh/elfui-kit",
  "bugs": {
    "url": "https://github.com/bloom-lmh/elfui-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
