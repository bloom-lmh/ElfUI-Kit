{
  "name": "elfui-kit-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @elfui/website dev",
    "build": "pnpm build:website",
    "build:website": "pnpm framework:check && pnpm --filter @elfui/website build",
    "build:lib": "pnpm framework:check && pnpm --filter @elfui/kit build",
    "baseline:collect": "pnpm build:lib && pnpm build:website && playwright test --config playwright.baseline.config.ts && node scripts/collect-repository-baseline.mjs",
    "baseline:critical-pages": "pnpm build:website && playwright test --config playwright.baseline.config.ts",
    "baseline:report": "node scripts/collect-repository-baseline.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm spellcheck && pnpm typecheck",
    "commit": "cz",
    "docs:locale-audit": "pnpm docs:locale-audit:strict",
    "docs:locale-audit:strict": "node scripts/audit-docs-locale.mjs",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "format:check:all": "prettier --check .",
    "format:baseline:update": "node scripts/check-format.mjs --update",
    "framework:check": "node scripts/check-framework-versions.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "spellcheck": "cspell --no-progress --show-suggestions .",
    "test": "pnpm test:contracts && pnpm test:kit && pnpm test:website",
    "test:contracts": "vitest run scripts --maxWorkers=2",
    "test:kit": "vitest run packages/kit/src --maxWorkers=2",
    "test:native-form:browser": "pnpm build:website && playwright test --config playwright.native-form.config.ts",
    "test:website": "vitest run apps/website/src --maxWorkers=2",
    "typecheck": "pnpm typecheck:kit && pnpm typecheck:website",
    "typecheck:kit": "node scripts/check-unsupported-macros.mjs packages/kit/src && node scripts/typecheck-macros.mjs packages/kit/tsconfig.lib.json",
    "typecheck:website": "node scripts/check-unsupported-macros.mjs apps/website/src && node scripts/typecheck-macros.mjs apps/website/tsconfig.json --no-template-typecheck",
    "verify:package": "pnpm build:lib && pnpm verify:package:built && pnpm verify:tarball",
    "verify:package:built": "node scripts/verify-package.mjs",
    "verify:tarball": "node scripts/verify-tarball-consumer.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepare": "husky",
    "prepublishOnly": "pnpm release:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@elfui/compiler": "0.1.0-beta.21",
    "@elfui/core": "0.1.0-beta.21",
    "@elfui/router": "0.1.0-beta.11",
    "@elfui/vite-plugin": "0.1.0-beta.21",
    "@playwright/test": "^1.62.1",
    "@eslint/js": "^10.0.1",
    "commitizen": "^4.3.2",
    "cspell": "^9.8.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "sass-embedded": "^1.83.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
