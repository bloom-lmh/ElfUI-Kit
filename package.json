{
  "name": "@elfui/kit",
  "version": "0.0.2-beta.1",
  "private": false,
  "type": "module",
  "description": "Official ElfUI component library built with macro components.",
  "main": "./lib-dist/elfui-kit.js",
  "module": "./lib-dist/elfui-kit.js",
  "types": "./lib-dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./lib-dist/library.d.ts",
      "import": "./lib-dist/elfui-kit.js"
    },
    "./labs": {
      "types": "./lib-dist/labs.d.ts",
      "import": "./lib-dist/labs.js"
    },
    "./styles/utilities.css": "./lib-dist/utilities.css"
  },
  "files": [
    "lib-dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/components/index.ts",
    "./src/components/**/index.ts",
    "./lib-dist/elfui-kit.js",
    "./lib-dist/labs.js",
    "./lib-dist/utilities.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "pnpm typecheck && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/prepare-package.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm spellcheck && pnpm typecheck",
    "commit": "cz",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:locale-audit": "node scripts/audit-docs-locale.mjs",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "format:check:all": "prettier --check .",
    "format:baseline:update": "node scripts/check-format.mjs --update",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "spellcheck": "cspell --no-progress --show-suggestions .",
    "typecheck": "node scripts/check-unsupported-macros.mjs && node scripts/typecheck-macros.mjs",
    "prepare": "husky",
    "prepublishOnly": "pnpm test && pnpm build:lib"
  },
  "dependencies": {
    "@elfui/core": "0.1.0-beta.20",
    "@elfui/router": "0.1.0-beta.10",
    "@mdi/js": "^7.4.47",
    "prettier": "^3.9.6",
    "shiki": "^4.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@elfui/compiler": "0.1.0-beta.20",
    "@elfui/vite-plugin": "0.1.0-beta.20",
    "@eslint/js": "^10.0.1",
    "commitizen": "^4.3.2",
    "cspell": "^9.8.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "sass-embedded": "^1.83.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloom-lmh/elfui-kit.git"
  },
  "homepage": "https://github.com/bloom-lmh/elfui-kit",
  "bugs": {
    "url": "https://github.com/bloom-lmh/elfui-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
